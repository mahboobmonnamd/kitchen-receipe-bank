        {
          "name": "pine nuts",
          "amount": 1.0,
          "unit": "cup",
          "sort_order": 10
        }
      ],
      "steps": [
        {
          "step_number": 1,
          "title": "Step 1",
          "instruction": "Heat 1/4 cup butter in a large saucepan over medium-high heat. Add ground beef and season with salt, allspice, cinnamon, and black pepper. Cook and stir until beef is browned and crumbly, 7 to 10 minutes."
        },
        {
          "step_number": 2,
          "title": "Step 2",
          "instruction": "Stir chicken broth and rice into beef in the saucepan; bring to a boil. Reduce heat to low, cover, and cook until liquid is absorbed, about 20 minutes."
        },
        {
          "step_number": 3,
          "title": "Step 3",
          "instruction": "Meanwhile, melt 2 tablespoons butter in a small skillet over medium heat. Cook and stir pine nuts in hot butter until lightly browned, 3 to 5 minutes."
        },
        {
          "step_number": 4,
          "title": "Step 4",
          "instruction": "Mix pine nuts into beef-rice mixture before serving."
        }
      ]
