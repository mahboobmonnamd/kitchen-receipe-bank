      "steps": [
        {
          "step_number": 1,
          "title": "Step 1",
          "instruction": "Sorrel jam instructions"
        },
        {
          "step_number": 2,
          "title": "Step 2",
          "instruction": "Combine sugar, sorrel, lemon zest, water in a medium sized pot."
        },
        {
          "step_number": 3,
          "title": "Step 3",
          "instruction": "Bring to a boil as petal becomes soft"
        },
        {
          "step_number": 4,
          "title": "Step 4",
          "instruction": "Reduce heat, and cook until thickened."
        },
        {
          "step_number": 5,
          "title": "Step 5",
          "instruction": "Let it rest before using on brie"
        },
        {
          "step_number": 6,
          "title": "Step 6",
          "instruction": "Baked brie instructions"
        },
        {
          "step_number": 7,
          "title": "Step 7",
          "instruction": "You can slice the brie in half to create a sandwich-like effect. Or you can leave the brie wheel intact and just trim the top rind of the wheel."
        },
        {
          "step_number": 8,
          "title": "Step 8",
          "instruction": "Add a generous portion of jam to the top of the wheel, or one side of the sandwich"
        },
        {
          "step_number": 9,
          "title": "Step 9",
          "instruction": "Roll dough out with a rolling pin on a floured surface"
        },
        {
          "step_number": 10,
          "title": "Step 10",
          "instruction": "Trim excess dough. You can also use it to decorate ."
        },
        {
          "step_number": 11,
          "title": "Step 11",
          "instruction": "Wrap the pastry up around the sides and over the top of cheese wheel, wrapping completely and pressing the edges of dough together to form a tightly sealed package."
        },
        {
          "step_number": 12,
          "title": "Step 12",
          "instruction": "Carefully flip the dough-wrapped cheese over, so that the gathered dough is on the bottom.Place the package, seam side down, on a baking sheet sprayed with non-stick cooking spray."
        },
        {
          "step_number": 13,
          "title": "Step 13",
          "instruction": "The brie can be prepared up to this point and refrigerated for 2 days before baking."
        },
        {
          "step_number": 14,
          "title": "Step 14",
          "instruction": "Be sure to bring the brie to room temperature before baking."
        }
      ]
    },
