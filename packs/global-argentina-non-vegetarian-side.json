      "steps": [
        {
          "step_number": 1,
          "title": "Step 1",
          "instruction": "Prepare the Batter: Whisk together chickpea flour, water, salt, and pepper. Let sit for at least 4 hours."
        },
        {
          "step_number": 2,
          "title": "Step 2",
          "instruction": "Bake: Preheat the oven to 220\u00b0C (430\u00b0F). Pour olive oil into a round baking dish and heat in the oven. Pour in the batter and bake for 25-30 minutes, until golden."
        },
        {
          "step_number": 3,
          "title": "Step 3",
          "instruction": "Serve: Slice and serve hot, optionally with black pepper on top."
        },
        {
          "step_number": 4,
          "title": "Step 4",
          "instruction": "Pro Tips:"
        },
        {
          "step_number": 5,
          "title": "Step 5",
          "instruction": "Let the batter rest for at least 2 hours, or overnight in the refrigerator, to ensure the chickpea flour fully hydrates and the flavors meld."
        },
        {
          "step_number": 6,
          "title": "Step 6",
          "instruction": "For a crispy edge, preheat the baking pan with oil in the oven before adding the batter."
        }
