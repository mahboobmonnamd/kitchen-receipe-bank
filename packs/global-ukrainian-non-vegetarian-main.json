      "steps": [
        {
          "step_number": 1,
          "title": "Step 1",
          "instruction": "step 1"
        },
        {
          "step_number": 2,
          "title": "Step 2",
          "instruction": "To make the stock, put the meat, whole onion, bay leaf and 2 litres of lightly salted cold water in a large saucepan. Cook over a very low heat for 1 hr 30 mins or until the beef shin is soft and falls apart easily \u2013 this can take up to 3 hrs. Skim off the scum with a spoon from time to time. Break up any larger pieces of beef into the broth, remove the whole onion and discard."
        },
        {
          "step_number": 3,
          "title": "Step 3",
          "instruction": "step 2"
        },
        {
          "step_number": 4,
          "title": "Step 4",
          "instruction": "Add the potatoes to the borscht, season well with salt and pepper and cook for 10-15 mins until tender. Meanwhile, heat the sunflower oil in a large, deep frying pan. Add the diced onion and carrot, and cook over a medium heat, stirring, until the carrot is soft and is about to start caramelising."
        },
        {
          "step_number": 5,
          "title": "Step 5",
          "instruction": "step 3"
        },
        {
          "step_number": 6,
          "title": "Step 6",
          "instruction": "Add the beetroot and cook for around 5 mins, stirring occasionally. Add the red pepper, if using, and cook for another 2 mins, then add the tomatoes and prunes, stir, then increase the heat and boil to reduce slightly, before adding everything to the borscht."
        },
        {
          "step_number": 7,
          "title": "Step 7",
          "instruction": "step 4"
        },
        {
          "step_number": 8,
          "title": "Step 8",
          "instruction": "Add the shredded cabbage and the kidney beans, and cook for 7-10 mins or until tender. Serve with a dollop of sour cream or cr\u00e8me fra\u00eeche, lots of chopped dill and some crusty bread."
        }
      ]
