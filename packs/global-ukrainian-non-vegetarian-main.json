        {
          "step_number": 2,
          "title": "Step 2",
          "instruction": "Halve the cabbage, remove the tough stem and thinly slice. Place in a large pan with all the other ingredients apart from the sausages, then mix in 300ml water and some salt and pepper."
        },
        {
          "step_number": 3,
          "title": "Step 3",
