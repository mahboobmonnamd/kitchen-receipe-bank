          "step_number": 1,
          "title": "Step 1",
          "instruction": "Brown the Beef: In a large pot, brown the beef cubes. Remove and set aside."
        },
        {
          "step_number": 2,
          "title": "Step 2",
          "instruction": "Saut\u00e9 Vegetables: In the same pot, cook the onion until translucent. Add carrots, potatoes, and pumpkin, cooking for a few minutes."
        },
        {
          "step_number": 3,
          "title": "Step 3",
          "instruction": "Simmer: Return the beef to the pot. Add broth and dried apricots. Season with salt and pepper. Simmer for 1-2 hours, until the beef is tender."
        },
        {
          "step_number": 4,
          "title": "Step 4",
          "instruction": "Serve: Enjoy hot, with a crusty piece of bread."
        },
        {
          "step_number": 5,
          "title": "Step 5",
          "instruction": "Pro Tips:"
        },
        {
          "step_number": 6,
          "title": "Step 6",
          "instruction": "Brown the beef in batches to ensure it gets a good sear, which adds depth to the stew's flavor."
        },
        {
          "step_number": 7,
          "title": "Step 7",
          "instruction": "Adding the fruits towards the end of cooking preserves their texture and adds a subtle sweetness to the dish."
