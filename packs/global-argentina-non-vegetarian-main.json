      "ingredients": [
        {
          "name": "mixed beef cuts",
          "amount": 2.0,
          "unit": "kg",
          "sort_order": 1
        },
        {
          "name": "chorizo",
          "amount": 4.0,
          "unit": "unit",
          "sort_order": 2
        },
        {
          "name": "morcilla",
          "amount": 2.0,
          "unit": "unit",
