      "steps": [
        {
          "step_number": 1,
          "title": "Step 1",
          "instruction": "\u25a2"
        },
        {
          "step_number": 2,
          "title": "Step 2",
          "instruction": "Cook the sour cream in a covered saucepan on medium heat for about 5 minutes."
        },
        {
          "step_number": 3,
          "title": "Step 3",
          "instruction": "\u25a2"
        },
        {
          "step_number": 4,
          "title": "Step 4",
          "instruction": "Turn down the heat and add half of the flour and stir well with a whisk. Once the flour is fully incorporated, let the mixture continue to cook, stirring occasionally, until fat starts to release. Use a spoon to gather as much of the fat as you can in a small bowl, saving for later. (Don't worry if you can't get any fat \u2013 in that case you can add butter later.)"
        },
        {
          "step_number": 5,
          "title": "Step 5",
          "instruction": "\u25a2"
        },
        {
          "step_number": 6,
          "title": "Step 6",
          "instruction": "Whisk in the rest of the flour and then slowly add the milk, whisking constantly to avoid lumps. Let the porridge continue to cook on low heat for 5 minutes and then add salt."
        },
        {
          "step_number": 7,
          "title": "Step 7",
          "instruction": "\u25a2"
        },
        {
          "step_number": 8,
          "title": "Step 8",
          "instruction": "Serve with sugar, cinnamon, and the fat from the porridge. If you're using lower fat sour cream you can top the r\u00f8mmegr\u00f8t with some butter instead."
        }
      ]
    }
