      },
      "texture": "dry",
      "servings_base": 4,
      "prep_time_minutes": 20,
      "cook_time_minutes": 30,
      "difficulty": "medium",
      "freezer_suitable": false,
      "photos": [
        "https://www.themealdb.com/images/media/meals/1550441275.jpg"
      ],
      "notes": "Source: TheMealDB id 52964. Free for commercial use. https://www.themealdb.com/",
      "ingredients": [
        {
          "name": "butter",
          "amount": 50.0,
          "unit": "g",
          "sort_order": 1
        },
        {
          "name": "onion",
          "amount": 1.0,
          "unit": "chopped",
          "sort_order": 2
        },
        {
          "name": "cardamom",
          "amount": 3.0,
          "unit": "Pods",
          "sort_order": 3
        },
        {
          "name": "turmeric",
          "amount": 1.0,
          "unit": "tsp",
          "sort_order": 4
        },
        {
          "name": "cinnamon stick",
          "amount": 1.0,
          "unit": "small",
          "sort_order": 5
        },
        {
          "name": "bay leaf",
          "amount": 1.0,
          "unit": "Sprigs of fresh",
          "sort_order": 6
        },
        {
          "name": "basmati rice",
          "amount": 450.0,
          "unit": "g",
          "sort_order": 7
        },
        {
          "name": "chicken stock",
          "amount": 1.0,
          "unit": "Litre",
          "sort_order": 8
        },
        {
          "name": "smoked haddock",
          "amount": 750.0,
          "unit": "g",
          "sort_order": 9
        },
        {
          "name": "eggs",
          "amount": 3.0,
          "unit": "unit",
          "sort_order": 10
        },
        {
          "name": "parsley",
          "amount": 3.0,
          "unit": "tblsp chopped",
          "sort_order": 11
        },
        {
          "name": "lemon",
          "amount": 1.0,
          "unit": "chopped",
          "sort_order": 12
        }
      ],
      "steps": [
        {
          "step_number": 1,
          "title": "Step 1",
          "instruction": "Melt 50g butter in a large saucepan (about 20cm across), add 1 finely chopped medium onion and cook gently over a medium heat for 5 minutes, until softened but not browned."
        },
        {
          "step_number": 2,
          "title": "Step 2",
          "instruction": "Stir in 3 split cardamom pods, \u00bc tsp turmeric, 1 small cinnamon stick and 2 bay leaves, then cook for 1 minute."
        },
        {
          "step_number": 3,
          "title": "Step 3",
          "instruction": "Tip in 450g basmati rice and stir until it is all well coated in the spicy butter."
        },
        {
          "step_number": 4,
          "title": "Step 4",
          "instruction": "Pour in 1 litre chicken or fish stock, add \u00bd teaspoon salt and bring to the boil, stir once to release any rice from the bottom of the pan. Cover with a close-fitting lid, reduce the heat to low and leave to cook very gently for 12 minutes."
        },
        {
          "step_number": 5,
          "title": "Step 5",
          "instruction": "Meanwhile, bring some water to the boil in a large shallow pan. Add 750g un-dyed smoked haddock fillet and simmer for 4 minutes, until the fish is just cooked. Lift it out onto a plate and leave until cool enough to handle."
        },
        {
          "step_number": 6,
          "title": "Step 6",
          "instruction": "Hard-boil 3 eggs for 8 minutes."
        },
        {
          "step_number": 7,
          "title": "Step 7",
          "instruction": "Flake the fish, discarding any skin and bones. Drain the eggs, cool slightly, then peel and chop."
        },
        {
          "step_number": 8,
          "title": "Step 8",
          "instruction": "Uncover the rice and remove the bay leaves, cinnamon stick and cardamom pods if you wish to. Gently fork in the fish and the chopped eggs, cover again and return to the heat for 2-3 minutes, or until the fish has heated through."
        },
        {
          "step_number": 9,
          "title": "Step 9",
          "instruction": "Gently stir in almost all the 3 tbsp chopped fresh parsley, and season with a little salt and black pepper to taste. Serve scattered with the remaining parsley and garnished with 1 lemon, cut into wedges."
        }
      ]
    }
  ]
