      "steps": [
        {
          "step_number": 1,
          "title": "Step 1",
          "instruction": "Wash and soak toor dal in approx. 3 cups of water, for at least one hours. Dal will be double in volume after soaking. Drain the water."
        },
        {
          "step_number": 2,
          "title": "Step 2",
          "instruction": "Cook dal with 2-1/2 cups water and add salt, turmeric, on medium high heat, until soft in texture (approximately 30 mins) it should be like thick soup."
        },
        {
          "step_number": 3,
          "title": "Step 3",
          "instruction": "In a frying pan, heat the ghee. Add cumin seeds, and mustard seeds. After the seeds crack, add bay leaves, green chili, ginger and chili powder. Stir for a few seconds."
        },
        {
          "step_number": 4,
          "title": "Step 4",
          "instruction": "Add tomatoes, salt and sugar stir and cook until tomatoes are tender and mushy."
        },
        {
          "step_number": 5,
          "title": "Step 5",
          "instruction": "Add cilantro and garam masala cook for about one minute."
        },
        {
          "step_number": 6,
          "title": "Step 6",
          "instruction": "Pour the seasoning over dal mix it well and cook for another minute."
        },
        {
          "step_number": 7,
          "title": "Step 7",
          "instruction": "Serve with Naan."
        }
      ],
