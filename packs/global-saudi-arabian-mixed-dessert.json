      "steps": [
        {
          "step_number": 1,
          "title": "Step 1",
          "instruction": "1"
        },
        {
          "step_number": 2,
          "title": "Step 2",
          "instruction": "Take kanfhe in a bowl and roughly cut them. Pour melted butter, yellow food color and mix well with your hands."
        },
        {
          "step_number": 3,
          "title": "Step 3",
          "instruction": "In a separate bowl mix milk, cream cheese, sugar, cornstarch well."
        },
        {
          "step_number": 4,
          "title": "Step 4",
          "instruction": "2"
        },
        {
          "step_number": 5,
          "title": "Step 5",
          "instruction": "Turn on the flame and boil the liquid, when it gets thick turn off the flame let it cool down a little bit."
        },
        {
          "step_number": 6,
          "title": "Step 6",
          "instruction": "Add mozzarella in it and mix it well."
        },
        {
          "step_number": 7,
          "title": "Step 7",
          "instruction": "Now make a base with half of the kanfhe in a dish, gently press it to level the dough well."
        },
        {
          "step_number": 8,
          "title": "Step 8",
          "instruction": "Pour the cheese mixture on the top and level it with a spoon."
        },
        {
          "step_number": 9,
          "title": "Step 9",
          "instruction": "3"
        },
        {
          "step_number": 10,
          "title": "Step 10",
          "instruction": "Cover it with the other half of the kanfhe."
        },
        {
          "step_number": 11,
          "title": "Step 11",
          "instruction": "Put the dish in a preheated oven at 200 degree for about 20-25 minutes."
        },
        {
          "step_number": 12,
          "title": "Step 12",
          "instruction": "It's ready when kunafa is golden and crunchy in the surface."
        },
        {
          "step_number": 13,
          "title": "Step 13",
          "instruction": "4"
        },
        {
          "step_number": 14,
          "title": "Step 14",
          "instruction": "Boil water in a pan and dissolve sugar in it for 4\u20135 minutes. OR cook it until slightly thicken and keep on stirring. Add lemon juice with rose water, mix well."
        }
      ]
