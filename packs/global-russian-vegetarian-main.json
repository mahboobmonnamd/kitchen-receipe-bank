      "steps": [
        {
          "step_number": 1,
          "title": "Step 1",
          "instruction": "Add the butter to a large Dutch oven or other heavy-duty pot over medium heat. When the butter has melted, add the onion and saut\u00e9 until translucent."
        },
        {
          "step_number": 2,
          "title": "Step 2",
          "instruction": "Add the cabbage, carrot, and celery. Saut\u00e9 until the vegetables begin to soften, stirring frequently, about 3 minutes."
        },
        {
          "step_number": 3,
          "title": "Step 3",
          "instruction": "Add the bay leaf and vegetable stock and bring to a boil over high heat. Reduce the heat to low and simmer, covered, until the vegetables are crisp-tender, about 15 minutes."
        },
        {
          "step_number": 4,
          "title": "Step 4",
          "instruction": "Add the potatoes and bring it back to a boil over high heat. Reduce the heat to low and simmer, covered, until the potatoes are tender, about 10 minutes."
        },
        {
          "step_number": 5,
          "title": "Step 5",
          "instruction": "Add the tomatoes (or undrained canned tomatoes) and bring the soup back to a boil over high heat. Reduce the heat to low and simmer, uncovered, for 5 minutes. Season to taste with salt and pepper."
        },
        {
          "step_number": 6,
          "title": "Step 6",
          "instruction": "emove and discard the bay leaf from the pot."
        },
        {
          "step_number": 7,
          "title": "Step 7",
          "instruction": "Serve topped with fresh sour cream and fresh dill."
        }
      ]
    },
