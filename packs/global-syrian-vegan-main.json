      "steps": [
        {
          "step_number": 1,
          "title": "Step 1",
          "instruction": "Preheat the oven to 450 degrees F (230 degrees C). Place falafel on a baking sheet."
        },
        {
          "step_number": 2,
          "title": "Step 2",
          "instruction": "Bake in the preheated oven until heated through, 8 to 10 minutes."
        },
        {
          "step_number": 3,
          "title": "Step 3",
          "instruction": "While falafel bake, whisk tahini, water, lemon juice, garlic, and paprika together in a bowl."
        },
        {
          "step_number": 4,
          "title": "Step 4",
          "instruction": "Cut about 1 inch from the top of each pita to form a pocket. Add 2 falafel to each pita with equal amounts lettuce, tomato, cucumber, pickle, and red onion. Drizzle each with about 1 tablespoon tahini sauce and some harissa."
        }
