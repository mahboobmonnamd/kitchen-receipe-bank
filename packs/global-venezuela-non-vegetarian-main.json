      "steps": [
        {
          "step_number": 1,
          "title": "Step 1",
          "instruction": "Cook the meat: Place the flank steak in a pot with broth or water and salt. Cook over low heat for about 2 hours, until tender and easy to shred."
        },
        {
          "step_number": 2,
          "title": "Step 2",
          "instruction": "Shred the meat: Once cooked, drain and shred the meat using two forks."
        },
        {
          "step_number": 3,
          "title": "Step 3",
          "instruction": "Prepare the vegetables: Saut\u00e9 chopped onion, bell pepper, and garlic in a little oil. Add cumin, oregano, paprika, and salt. Stir in the meat and cook for a few minutes until the flavors are well combined."
        },
        {
          "step_number": 4,
          "title": "Step 4",
          "instruction": "Make the dough: In a bowl, mix the cornmeal with warm water and salt until a soft dough forms. Let it rest for 5 minutes."
        },
        {
          "step_number": 5,
          "title": "Step 5",
          "instruction": "Form the arepas: Divide the dough into 6 portions, shape into balls, and flatten into thick discs."
        },
        {
          "step_number": 6,
          "title": "Step 6",
          "instruction": "Cook: Cook the arepas on a griddle or skillet over medium heat for 2\u20133 minutes on each side until golden. You can then bake them for a few minutes if you prefer them crispier."
        },
        {
          "step_number": 7,
          "title": "Step 7",
          "instruction": "Fill: Slice the arepas open on one side, fill with the hot shredded beef, and top with grated cheese."
        }
      ]
