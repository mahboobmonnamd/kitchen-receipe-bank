      "steps": [
        {
          "step_number": 1,
          "title": "Step 1",
          "instruction": "Season beef with salt, pepper and minced garlic"
        },
        {
          "step_number": 2,
          "title": "Step 2",
          "instruction": "Chop 1 onion in 4 big wedges"
        },
        {
          "step_number": 3,
          "title": "Step 3",
          "instruction": "Place in the beef pressure cooker with the 4 wedges of onion and the stock"
        },
        {
          "step_number": 4,
          "title": "Step 4",
          "instruction": "Pressure cook for 20 minutes"
        },
        {
          "step_number": 5,
          "title": "Step 5",
          "instruction": "Release the pressure and open the lid"
        },
        {
          "step_number": 6,
          "title": "Step 6",
          "instruction": "Remove the beef and SAVE 2 cups of stock in another container"
        },
        {
          "step_number": 7,
          "title": "Step 7",
          "instruction": "With 2 forks, shred the beef. Beef should be tender enough to so easily. If not, cook for another 10 minutes"
        },
        {
          "step_number": 8,
          "title": "Step 8",
          "instruction": "Press the saute button of the Instant pot. Add the olive oil"
        },
        {
          "step_number": 9,
          "title": "Step 9",
          "instruction": "When the machine beeps, add the sliced onion, pepper and tomatoes. Cook until tender"
        },
        {
          "step_number": 10,
          "title": "Step 10",
          "instruction": "Add the shredded beef back in the pot and mix"
        },
        {
          "step_number": 11,
          "title": "Step 11",
          "instruction": "Pour in 1 1/2 cups of the saved stock, the Worcestershire sauce, tomato paste, ketchup and cumin. Mix"
        },
        {
          "step_number": 12,
          "title": "Step 12",
          "instruction": "If sauce seems to dry, add a tad more of stock"
        },
        {
          "step_number": 13,
          "title": "Step 13",
          "instruction": "Season with salt and pepper"
        },
        {
          "step_number": 14,
          "title": "Step 14",
          "instruction": "Serve!"
        }
      ]
    }
