      "steps": [
        {
          "step_number": 1,
          "title": "Step 1",
          "instruction": "Preheat the oven at 180 C / Gas 4. Line a baking tray with greaseproof paper."
        },
        {
          "step_number": 2,
          "title": "Step 2",
          "instruction": "In a bowl, mix the cashews and icing sugar. Add the egg yolks and orange blossom water and mix to a smooth homogeneous paste."
        },
        {
          "step_number": 3,
          "title": "Step 3",
          "instruction": "Take lumps of the cashew paste and shape into small balls. Roll the balls in icing sugar and transfer to the baking tray. Push an almond in the centre of each ghribia."
        },
        {
          "step_number": 4,
          "title": "Step 4",
          "instruction": "Bake until the biscuits are lightly golden, about 20 minutes. Keep an eye on them, they burn quickly."
        }
      ]
