      "ingredients": [
        {
          "name": "heavy cream",
          "amount": 2.0,
          "unit": "cups",
          "sort_order": 1
        },
        {
          "name": "condensed milk",
          "amount": 1.0,
          "unit": "oz",
          "sort_order": 2
        },
        {
          "name": "vanilla extract",
          "amount": 1.0,
          "unit": "tsp",
          "sort_order": 3
        },
        {
          "name": "grape nut cereal",
          "amount": 1.0,
          "unit": "cup",
          "sort_order": 4
        }
      ],
      "steps": [
        {
          "step_number": 1,
          "title": "Step 1",
          "instruction": "In a large bowl, use an electric mixer to whip the cold heavy cream until stiff peaks form. Gently fold in the sweetened condensed milk and vanilla extract until well combined."
        },
        {
          "step_number": 2,
          "title": "Step 2",
          "instruction": "Fold in the cereal and stir until evenly distributed throughout the mixture."
        },
        {
          "step_number": 3,
          "title": "Step 3",
          "instruction": "Pour the mixture into a freezer-safe container (such as a loaf pan). Lay plastic wrap on top of the ice cream to avoid freezer burn. Cover the container and freeze for at least 6 hours or until solid."
        },
        {
          "step_number": 4,
          "title": "Step 4",
          "instruction": "Once frozen, let the ice cream sit at room temperature for a few minutes to soften slightly before scooping and serving."
        }
      ]
