      "steps": [
        {
          "step_number": 1,
          "title": "Step 1",
          "instruction": "step 1"
        },
        {
          "step_number": 2,
          "title": "Step 2",
          "instruction": "In a wide, shallow bowl, beat the eggs with the cream, milk, golden caster sugar and sherry. Cut each slice of bread in two and dip them into the egg mix, turning to make sure they get a good coating on either side. Soak bread in egg mixture for 10 mins to absorb the liquid (carefully turn them over from time to time and make sure they don\u2019t get too soggy)."
        },
        {
          "step_number": 3,
          "title": "Step 3",
          "instruction": "step 2"
        },
        {
          "step_number": 4,
          "title": "Step 4",
          "instruction": "Heat 1\u00bd tbsp olive oil in a large frying pan and cook the bread for about 3 mins on each side until dark golden and crisp on the edge. Keep the slices warm in a low oven as you cook the rest."
        },
        {
          "step_number": 5,
          "title": "Step 5",
          "instruction": "step 3"
        },
        {
          "step_number": 6,
          "title": "Step 6",
          "instruction": "Divide the torrijas between plates and dust with the icing sugar. Serve with cr\u00e8me fra\u00eeche or Greek yogurt on the side."
        }
      ]
