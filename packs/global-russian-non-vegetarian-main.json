      "steps": [
        {
          "step_number": 1,
          "title": "Step 1",
          "instruction": "Place the raisins and prunes into a small bowl and pour over enough water to cover. Add lemon juice and let soak for at least 1 hour. Drain. Roughly chop the prunes."
        },
        {
          "step_number": 2,
          "title": "Step 2",
          "instruction": "Meanwhile, heat the butter in a large pan, add the onion, and cook for 5 minutes. Add cubed lamb, ground lamb, and crushed garlic cloves. Fry for 5 minutes, stirring constantly until browned."
        },
        {
          "step_number": 3,
          "title": "Step 3",
          "instruction": "Pour 2/3 cup (150 milliliters) of stock into the pan. Bring to a boil, then lower the heat, cover, and simmer for 1 hour, or until the lamb is tender."
        },
        {
          "step_number": 4,
          "title": "Step 4",
          "instruction": "Add the remaining stock and bring to a boil. Add rinsed long-grain white rice and a large pinch of saffron. Stir, then cover, and simmer for 15 minutes, or until the rice is tender."
        },
        {
          "step_number": 5,
          "title": "Step 5",
          "instruction": "Add the drained raisins, drained chopped prunes, and salt and pepper to taste. Heat through for a few minutes, then turn out onto a warmed serving dish and garnish with sprigs of flat-leaf parsley."
        }
      ]
