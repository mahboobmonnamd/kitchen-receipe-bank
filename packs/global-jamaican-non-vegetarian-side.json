        {
          "name": "salt",
          "amount": 1.0,
          "unit": "tsp",
          "sort_order": 4
        },
        {
          "name": "water",
          "amount": 1.0,
          "unit": "cup",
          "sort_order": 5
        }
      ],
      "steps": [
        {
          "step_number": 1,
          "title": "Step 1",
          "instruction": "Instructions"
        },
        {
          "step_number": 2,
          "title": "Step 2",
          "instruction": "In a large pot, bring water and salt to a boil to boil the dumplings."
        },
        {
          "step_number": 3,
          "title": "Step 3",
          "instruction": "In a large mixing bowl, combine the all-purpose flour and salt, stirring to distribute the salt evenly throughout the flour. Gradually add water to the flour mixture, mixing with your hands until a dough forms."
        },
        {
          "step_number": 4,
          "title": "Step 4",
          "instruction": "Divide the dough into equal-sized pieces, rolling each into a smooth ball. Flatten each ball slightly with the palm of your hand to form a round, circular dumpling. It should look like a thick disk."
        },
        {
          "step_number": 5,
          "title": "Step 5",
          "instruction": "Carefully drop the dumplings into the boiling water, one at a time, ensuring that they don't stick together. You can use a wooden spoon to stir the dumplings in the water."
        },
        {
          "step_number": 6,
          "title": "Step 6",
          "instruction": "Boil the dumplings for 15-20 minutes, or until they are cooked through and have risen to the surface of the water. Stir occasionally to prevent sticking."
        },
        {
          "step_number": 7,
          "title": "Step 7",
          "instruction": "Use a slotted spoon to remove the cooked dumplings from the pot, allowing any excess water to drain."
        },
        {
          "step_number": 8,
          "title": "Step 8",
          "instruction": "Serve with your favorite recipes."
        }
      ]
