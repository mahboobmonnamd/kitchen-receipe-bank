          "name": "oil",
          "amount": 1.0,
          "unit": "For frying",
          "sort_order": 8
        }
      ],
      "steps": [
        {
          "step_number": 1,
          "title": "Step 1",
          "instruction": "Heat a heavy bottom pot of oil that has at least 3 inches of oil in it or use a deep fryer if you have one. Turn the heat over medium heat until the temperature reaches 350 degrees Fahrenheit."
        },
        {
          "step_number": 2,
          "title": "Step 2",
          "instruction": "Add the all-purpose flour, cornmeal, granulated sugar, baking powder, and salt to a large bowl and stir to combine."
        },
        {
          "step_number": 3,
          "title": "Step 3",
          "instruction": "Add the vanilla extract and milk and stir until the dough comes together. Then use your hands to lightly form the mixture into a ball."
        },
        {
          "step_number": 4,
          "title": "Step 4",
          "instruction": "Pinch off pieces of dough and roll them into long oval shapes. Make about 12 dumplings."
        },
        {
          "step_number": 5,
          "title": "Step 5",
          "instruction": "Once the oil has reached the temperature of 350 degrees Fahrenheit, fry the dough on all sides, until golden brown. This should take about 4-6 minutes."
        },
        {
          "step_number": 6,
          "title": "Step 6",
          "instruction": "Remove dough and drain off any excess grease. Serve and enjoy."
        }
      ]
