      "steps": [
        {
          "step_number": 1,
          "title": "Step 1",
          "instruction": "Grind almonds in an almond grinder or food processor."
        },
        {
          "step_number": 2,
          "title": "Step 2",
          "instruction": "\u25a2"
        },
        {
          "step_number": 3,
          "title": "Step 3",
          "instruction": "Mix almonds and powdered sugar together in a large mixing bowl. Add three of the egg whites and knead the dough together with your hands until it comes together in a ball. Wrap in cling film and leave in the fridge for at least an hour, preferably until the next day."
        },
        {
          "step_number": 4,
          "title": "Step 4",
          "instruction": "\u25a2"
        },
        {
          "step_number": 5,
          "title": "Step 5",
          "instruction": "Grease the kransekake forms thoroughly and coat with semolina, flour, or bread crumbs."
        },
        {
          "step_number": 6,
          "title": "Step 6",
          "instruction": "\u25a2"
        },
        {
          "step_number": 7,
          "title": "Step 7",
          "instruction": "Preheat oven to 210\u00b0C (410\u00b0F) top and bottom heat. Divide the dough into six sections."
        },
        {
          "step_number": 8,
          "title": "Step 8",
          "instruction": "\u25a2"
        },
        {
          "step_number": 9,
          "title": "Step 9",
          "instruction": "Slowly add the remaining egg white to the dough and knead it until you can roll it into long sausages about as thick as your index finger. Fill the forms with the dough sausages, pinching the ends together to make rings."
        },
        {
          "step_number": 10,
          "title": "Step 10",
          "instruction": "\u25a2"
        },
        {
          "step_number": 11,
          "title": "Step 11",
          "instruction": "Set the forms on a baking sheet and back in the middle of the oven for about 10 \u2013 12 minutes, until the tops are golden brown."
        }
      ]
