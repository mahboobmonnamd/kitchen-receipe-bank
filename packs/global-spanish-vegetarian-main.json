          "sort_order": 9
        },
        {
          "name": "olive oil",
          "amount": 1.0,
          "unit": "drizzle",
          "sort_order": 10
        }
      ],
      "steps": [
        {
          "step_number": 1,
          "title": "Step 1",
          "instruction": "Put a large non-stick frying pan on a low heat. Cook the onion slowly in the oil and butter until soft but not brown \u2013 this should take about 15 mins. Add the potatoes, cover the pan and cook for a further 15-20 mins, stirring occasionally to make sure they fry evenly."
        },
        {
          "step_number": 2,
          "title": "Step 2",
          "instruction": "When the potatoes are soft and the onion is shiny, crush 2 garlic cloves and stir in, followed by the beaten eggs."
        },
        {
          "step_number": 3,
          "title": "Step 3",
          "instruction": "Put the lid back on the pan and leave the tortilla to cook gently. After 20 mins, the edges and base should be golden, the top set but the middle still a little wobbly. To turn it over, slide it onto a plate and put another plate on top, turn the whole thing over and slide it back into the pan to finish cooking. Once cooked, transfer to a plate and serve the tortilla warm or cold, scattered with the chopped parsley."
        },
        {
          "step_number": 4,
          "title": "Step 4",
          "instruction": "To accompany, take slices of warmed baguette, stab all over with a fork and rub with the remaining garlic, pile on grated tomatoes and season with sea salt and a drizzle of olive oil."
        }
      ]
