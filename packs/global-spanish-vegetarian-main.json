      "steps": [
        {
          "step_number": 1,
          "title": "Step 1",
          "instruction": "step 1"
        },
        {
          "step_number": 2,
          "title": "Step 2",
          "instruction": "Heat the oil in a large flameproof casserole dish or a cast-iron skillet over a low heat. Add the onions and a sprinkle of salt, cover and cook gently for 15 mins, stirring occasionally. Add the garlic and cook for another 2 mins."
        },
        {
          "step_number": 3,
          "title": "Step 3",
          "instruction": "step 2"
        },
        {
          "step_number": 4,
          "title": "Step 4",
          "instruction": "Next, throw in the peppers and cook over a medium heat, covered, for about 5 mins, stirring every so often, until the peppers are just tender."
        },
        {
          "step_number": 5,
          "title": "Step 5",
          "instruction": "step 3"
        },
        {
          "step_number": 6,
          "title": "Step 6",
          "instruction": "Mix in the oregano, thyme, bay leaves, some black pepper and a little salt, if needed. Tip in the courgettes and aubergine, combine thoroughly, and cook over a medium heat, covered, for 10 mins. Stir in the tomatoes, cover and cook for 20 mins, stirring occasionally."
        },
        {
          "step_number": 7,
          "title": "Step 7",
          "instruction": "step 4"
        },
        {
          "step_number": 8,
          "title": "Step 8",
          "instruction": "Carefully crack the eggs over the pisto \u2013 try not to break the yolks. Cook in the sauce on a medium heat for 5-6 mins until the eggs are cooked through but still a little soft, then scatter with parsley before serving"
        }
      ]
