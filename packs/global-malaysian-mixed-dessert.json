      "ingredients": [
        {
          "name": "rice",
          "amount": 400.0,
          "unit": "g",
          "sort_order": 1
        },
        {
          "name": "coconut milk",
          "amount": 150.0,
          "unit": "ml",
          "sort_order": 2
        },
        {
          "name": "water",
          "amount": 100.0,
          "unit": "ml",
          "sort_order": 3
        },
        {
          "name": "salt",
          "amount": 1.0,
          "unit": "tsp",
          "sort_order": 4
        },
        {
          "name": "corn flour",
          "amount": 5.0,
          "unit": "tbs",
          "sort_order": 5
        },
        {
          "name": "flour",
          "amount": 3.0,
          "unit": "tbs",
          "sort_order": 6
        },
        {
          "name": "eggs",
          "amount": 3.0,
          "unit": "unit",
          "sort_order": 7
        },
        {
          "name": "coconut cream",
          "amount": 200.0,
          "unit": "ml",
          "sort_order": 8
        },
        {
          "name": "sugar",
          "amount": 140.0,
          "unit": "g",
          "sort_order": 9
        }
      ],
      "steps": [
        {
          "step_number": 1,
          "title": "Step 1",
          "instruction": "Soak glutinous rice with water for at least 1 \u00bd hours prior to using. Drain."
        },
        {
          "step_number": 2,
          "title": "Step 2",
          "instruction": "Prepare a 9-inch round or square cake pan and spray with cooking spray or line with plastic wrap."
        },
        {
          "step_number": 3,
          "title": "Step 3",
          "instruction": "Mix coconut milk, water, salt and the rice. Pour it into cake pan, topped with the pandan knots."
        },
        {
          "step_number": 4,
          "title": "Step 4",
          "instruction": "Steam for 30 minutes."
        },
        {
          "step_number": 5,
          "title": "Step 5",
          "instruction": "After 30 minutes, fluff up the rice and remove pandan knots. Then, using a greased spatula, flatten the steamed rice. Make sure there are no holes/air bubbles and gaps in the rice, especially the sides."
        },
        {
          "step_number": 6,
          "title": "Step 6",
          "instruction": "Steam for another 10 minutes."
        },
        {
          "step_number": 7,
          "title": "Step 7",
          "instruction": "Combine pandan juice, coconut milk, all purpose flour, cornflour, and sugar. Mix well."
        },
        {
          "step_number": 8,
          "title": "Step 8",
          "instruction": "Add eggs and whisk well then strain into a medium sized metal bowl or pot."
        },
        {
          "step_number": 9,
          "title": "Step 9",
          "instruction": "Place pandan mixture over simmering water (double boiler or bain-marie)"
        },
        {
          "step_number": 10,
          "title": "Step 10",
          "instruction": "Stir continuously and cook till custard starts to thicken. (15 minutes)"
        },
        {
          "step_number": 11,
          "title": "Step 11",
          "instruction": "Pour pandan custard into glutinous rice layer, give it a little tap (for air bubbles) and continue to steam for 30 minutes."
        },
        {
          "step_number": 12,
          "title": "Step 12",
          "instruction": "Remove kuih seri muka from the steamer and allow to cool completely before cutting into rectangles or diamond shapes."
        }
      ]
    }
