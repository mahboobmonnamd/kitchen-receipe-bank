          "name": "salt",
          "amount": 1.0,
          "unit": "Pinch",
          "sort_order": 10
        },
        {
          "name": "pepper",
          "amount": 1.0,
          "unit": "Pinch",
          "sort_order": 11
        }
      ],
      "steps": [
        {
          "step_number": 1,
          "title": "Step 1",
          "instruction": "Cook potatoes - place potatoes in a pot of cold water, and bring to the boil. Boil 20 minutes, or until potatoes are tender. You know they are cooked when you can stick a knife in them and the knife goes straight through."
        },
        {
          "step_number": 2,
          "title": "Step 2",
          "instruction": "Combine harissa spice, olive oil, salt and pepper and lemon juice in a small bowl and whisk until combined."
        },
        {
          "step_number": 3,
          "title": "Step 3",
          "instruction": "Once potatoes are cooked, drain water and roughly chop potatoes in half."
        },
        {
          "step_number": 4,
          "title": "Step 4",
          "instruction": "Add harissa mix and spring onions/green onions to potatoes and stir."
        },
        {
          "step_number": 5,
          "title": "Step 5",
          "instruction": "In a large salad bowl, lay out arugula/rocket."
        },
        {
          "step_number": 6,
          "title": "Step 6",
          "instruction": "Top with potato mix and toss."
        },
        {
          "step_number": 7,
          "title": "Step 7",
          "instruction": "Add fetta, mint and sprinkle over pine nuts."
        },
        {
          "step_number": 8,
          "title": "Step 8",
          "instruction": "Adjust salt and pepper to taste."
        }
      ]
