        },
        {
          "name": "garlic",
          "amount": 1.0,
          "unit": "clove peeled crushed",
          "sort_order": 5
        },
        {
          "name": "yellow pepper",
          "amount": 1.0,
          "unit": "thinly sliced",
          "sort_order": 6
        },
        {
          "name": "green beans",
          "amount": 200.0,
          "unit": "g",
          "sort_order": 7
