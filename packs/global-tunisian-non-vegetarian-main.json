        }
      ],
      "steps": [
        {
          "step_number": 1,
          "title": "Step 1",
          "instruction": "In a large cast iron skillet or saut\u00e9 pan with a lid, heat oil over medium high heat."
        },
        {
          "step_number": 2,
          "title": "Step 2",
          "instruction": "Add the onion and saut\u00e9 for 2-3 minutes, until softened."
        },
        {
          "step_number": 3,
          "title": "Step 3",
          "instruction": "Add the peppers and garlic, and saut\u00e9 for an additional 3-5 minutes."
        },
        {
          "step_number": 4,
          "title": "Step 4",
          "instruction": "Add the tomatoes, cumin, paprika, salt, and chili powder."
        },
        {
          "step_number": 5,
          "title": "Step 5",
          "instruction": "Mix well and bring the mixture to a simmer."
        },
        {
          "step_number": 6,
          "title": "Step 6",
          "instruction": "Reduce the heat to medium low and continue to simmer, uncovered, 10-15 minutes until the mixture has thickened to your desired consistency."
        },
        {
          "step_number": 7,
          "title": "Step 7",
          "instruction": "(Taste the sauce at this point and adjust for salt and spice, as desired.) Using the back of a spoon, make four craters in the mixture, large enough to hold an egg."
        },
        {
          "step_number": 8,
          "title": "Step 8",
          "instruction": "Crack one egg into each of the craters."
        },
        {
          "step_number": 9,
          "title": "Step 9",
          "instruction": "Cover the skillet and simmer for 5-7 minutes, until the eggs have set."
        },
        {
          "step_number": 10,
          "title": "Step 10",
          "instruction": "Serve immediately with crusty bread or pita."
        }
      ]
