          "title": "Step 9",
          "instruction": "\u25a2"
        },
        {
          "step_number": 10,
          "title": "Step 10",
          "instruction": "Add water to the pot and bring to a boil. Cover and reduce heat. Cook on low heat for 2 \u2013 3 hours, until the lamb gently falls away from the bone."
        },
        {
          "step_number": 11,
          "title": "Step 11",
          "instruction": "\u25a2"
        },
        {
          "step_number": 12,
          "title": "Step 12",
          "instruction": "Serve with boiled potatoes and fresh parsley, covering generously with the f\u00e5rik\u00e5l broth."
        }
