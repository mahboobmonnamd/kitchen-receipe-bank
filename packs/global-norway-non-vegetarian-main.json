          "title": "Step 1",
          "instruction": "\u25a2"
        },
        {
          "step_number": 2,
          "title": "Step 2",
          "instruction": "Heat olive oil in a large pot. Cut beef into 1 inch (2.5 cm) cubes and brown in oil."
        },
        {
          "step_number": 3,
          "title": "Step 3",
          "instruction": "\u25a2"
        },
        {
          "step_number": 4,
          "title": "Step 4",
          "instruction": "Dice the onion and add to browning beef. Add the stock and bring to a boil, then lower the heat, cover, and let simmer for about 30 minutes."
        },
        {
          "step_number": 5,
          "title": "Step 5",
          "instruction": "\u25a2"
        },
        {
          "step_number": 6,
          "title": "Step 6",
          "instruction": "Peel and cut the rutabaga and celery root into 1 inch (2.5 cm) cubes. Add to the pot, cover, and continue simmering for another 30 minutes."
        },
        {
          "step_number": 7,
          "title": "Step 7",
          "instruction": "\u25a2"
        },
        {
          "step_number": 8,
          "title": "Step 8",
          "instruction": "Peel and chop the rest of the vegetables into 1 inch (2.5 cm) cubes and add to the pot. Slice the leek into rings. Cover and continue simmering for about 20 minutes. Stir as little as possible."
        },
        {
          "step_number": 9,
          "title": "Step 9",
          "instruction": "\u25a2"
        },
        {
          "step_number": 10,
          "title": "Step 10",
          "instruction": "Top with fresh parsley."
        }
      ]
