      "steps": [
        {
          "step_number": 1,
          "title": "Step 1",
          "instruction": "First, cook your vegetables. Bring a large pot of salted water to boil. Par-cook carrots and potatoes for five minutes until carrots and potatoes are fork tender, then blanch the peas and beans for about a minute in the same pot. Strain vegetables and set aside."
        },
        {
          "step_number": 2,
          "title": "Step 2",
          "instruction": "In a heavy-bottomed pot or Dutch oven, melt butter over medium heat, add vegetables, and cook to warm through."
        },
        {
          "step_number": 3,
          "title": "Step 3",
          "instruction": "Add milk and cream and bring the soup to a boil. Turn the heat down to low and season with salt and pepper."
        },
        {
          "step_number": 4,
          "title": "Step 4",
          "instruction": "Add dill and chives and let simmer for at least 10 minutes. Serve warm."
        }
      ]
