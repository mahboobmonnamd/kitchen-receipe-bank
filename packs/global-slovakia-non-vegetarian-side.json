      "steps": [
        {
          "step_number": 1,
          "title": "Step 1",
          "instruction": "1. Prepare the Potatoes"
        },
        {
          "step_number": 2,
          "title": "Step 2",
          "instruction": "Start by peeling and finely grating the potatoes. To ensure extra crispiness, use a clean kitchen towel to squeeze out as much moisture as possible."
        },
        {
          "step_number": 3,
          "title": "Step 3",
          "instruction": "2. Mix the Ingredients"
        },
        {
          "step_number": 4,
          "title": "Step 4",
          "instruction": "In a large mixing bowl, combine the grated potatoes, chopped onion, minced garlic, eggs, flour, marjoram, salt, and black pepper. Stir well until the mixture forms a thick, consistent batter."
        },
        {
          "step_number": 5,
          "title": "Step 5",
          "instruction": "3. Heat the Oil"
        },
        {
          "step_number": 6,
          "title": "Step 6",
          "instruction": "In a large frying pan, heat a generous amount of oil over medium heat. The oil should be hot but not smoking."
        },
        {
          "step_number": 7,
          "title": "Step 7",
          "instruction": "4. Fry the Pancakes"
        },
        {
          "step_number": 8,
          "title": "Step 8",
          "instruction": "Spoon portions of the batter into the pan, flattening each into a thin pancake. Fry until golden brown and crispy on one side, then flip and cook the other side until equally golden and crispy."
        },
        {
          "step_number": 9,
          "title": "Step 9",
          "instruction": "5. Drain & Serve"
        },
        {
          "step_number": 10,
          "title": "Step 10",
          "instruction": "Transfer the cooked pancakes onto a plate lined with paper towels to remove excess oil. Serve immediately while hot, with sour cream, garlic dip, or as a side dish."
        }
      ]
    }
